<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Entity Header -->
  <div class="bg-white shadow rounded-lg p-6 mb-6">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">
          Entity #<%= @entity[:id] %>
        </h1>
        <div class="mt-2">
          <span class="inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
            <%= @entity[:pool] %>
          </span>
        </div>
      </div>
    </div>
    
    <div class="mt-4">
      <h2 class="text-sm font-medium text-gray-500">Representation Text</h2>
      <p class="mt-1 text-lg text-gray-900">
        <%= @entity[:repr_text] || @entity[:label] || "No representation text available" %>
      </p>
    </div>
  </div>

  <!-- Edges by Verb -->
  <div class="bg-white shadow rounded-lg p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Relationships</h2>
    
    <% if @edges_by_verb.empty? %>
      <p class="text-gray-500">No relationships found for this entity.</p>
    <% else %>
      <div class="space-y-6">
        <% @sorted_verbs.each do |verb| %>
          <% edges = @edges_by_verb[verb] %>
          <div class="border-l-4 border-indigo-400 pl-4">
            <h3 class="text-lg font-semibold text-gray-900 capitalize mb-3">
              <%= verb.to_s.humanize %> (<%= edges.count %>)
            </h3>
            
            <div class="space-y-3">
              <% edges.each do |edge| %>
                <div class="bg-gray-50 rounded-lg p-4" data-edge-id="<%= edge[:id] %>">
                  <!-- Edge Direction and Target/Source -->
                  <div class="flex items-start justify-between">
                    <div class="flex-1">
                      <% if edge[:direction] == 'outgoing' %>
                        <p class="text-sm text-gray-600">
                          → <%= edge[:target][:pool] %>(<%= edge[:target][:label] %>)
                        </p>
                      <% else %>
                        <p class="text-sm text-gray-600">
                          ← <%= edge[:source][:pool] %>(<%= edge[:source][:label] %>)
                        </p>
                      <% end %>
                      
                      <!-- Path Sentence (for Verified edges) -->
                      <% if edge[:status] == 'verified' && edge[:path_sentence] %>
                        <div class="mt-2 p-2 bg-green-50 rounded">
                          <p class="text-sm font-medium text-green-900">Path Sentence:</p>
                          <p class="text-sm text-green-800"><%= edge[:path_sentence] %></p>
                        </div>
                      <% end %>
                    </div>
                    
                    <!-- Status Badge -->
                    <span class="ml-4 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                      <%= edge[:status] == 'verified' ? 'bg-green-100 text-green-800' : 
                          edge[:status] == 'candidate' ? 'bg-yellow-100 text-yellow-800' : 
                          'bg-gray-100 text-gray-800' %>">
                      <%= edge[:status] %>
                    </span>
                  </div>
                  
                  <!-- Evidence and Rights -->
                  <% if edge[:evidence_span] || edge[:rights_echo] %>
                    <details class="mt-3">
                      <summary class="cursor-pointer text-sm font-medium text-indigo-600 hover:text-indigo-500">
                        Citations & Rights
                      </summary>
                      <div class="mt-2 space-y-2">
                        <% if edge[:evidence_span] %>
                          <div class="bg-white p-2 rounded border border-gray-200">
                            <p class="text-xs font-medium text-gray-500">Evidence:</p>
                            <p class="text-sm text-gray-700">"<%= edge[:evidence_span] %>"</p>
                            <% if edge[:evidence_item_id] %>
                              <p class="text-xs text-gray-500 mt-1">Item ID: <%= edge[:evidence_item_id] %></p>
                            <% end %>
                          </div>
                        <% end %>
                        
                        <% if edge[:rights_echo] %>
                          <div class="bg-blue-50 p-2 rounded">
                            <p class="text-xs font-medium text-gray-500">Rights Echo:</p>
                            <ul class="text-xs text-gray-700 mt-1">
                              <li>Publishability: <%= edge[:rights_echo][:publishability] || 'unknown' %></li>
                              <li>Training Eligible: <%= edge[:rights_echo][:training_eligibility] || 'unknown' %></li>
                              <% if edge[:rights_echo][:license] %>
                                <li>License: <%= edge[:rights_echo][:license] %></li>
                              <% end %>
                            </ul>
                          </div>
                        <% end %>
                      </div>
                    </details>
                  <% end %>
                  
                  <!-- Action Buttons for Candidate Edges -->
                  <% if edge[:status] == 'candidate' %>
                    <div class="mt-3 flex gap-2">
                      <button onclick="promoteEdge(<%= edge[:id] %>)" 
                              class="inline-flex items-center px-3 py-1 border border-transparent text-xs font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                        Promote to Verified
                      </button>
                      <button onclick="rejectEdge(<%= edge[:id] %>)"
                              class="inline-flex items-center px-3 py-1 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Reject
                      </button>
                    </div>
                  <% end %>
                  
                  <!-- Metadata -->
                  <div class="mt-2 text-xs text-gray-500">
                    <% if edge[:confidence] %>
                      Confidence: <%= (edge[:confidence] * 100).round(1) %>% |
                    <% end %>
                    <% if edge[:verified_at] %>
                      Verified: <%= edge[:verified_at] %> by <%= edge[:verified_by] %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
function promoteEdge(edgeId) {
  if (confirm('Promote this edge to Verified status? This requires rights validation.')) {
    fetch(`/navigator/edges/${edgeId}/promote`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      },
      body: JSON.stringify({ reason: 'Manual curation via Navigator UI' })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status === 'success') {
        alert('Edge promoted successfully');
        location.reload();
      } else {
        alert('Failed to promote edge: ' + data.message);
      }
    });
  }
}

function rejectEdge(edgeId) {
  if (confirm('Reject this candidate edge? It will be removed from the graph.')) {
    fetch(`/navigator/edges/${edgeId}/reject`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      },
      body: JSON.stringify({ reason: 'Manual rejection via Navigator UI' })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status === 'success') {
        alert('Edge rejected successfully');
        location.reload();
      } else {
        alert('Failed to reject edge: ' + data.message);
      }
    });
  }
}
</script>