// ===== Fullscreen support for charts =====
const __fsRestore = {};

function reinitializeChart(id) {
  switch (id) {
    case 'network-graph':
      initializeNetworkGraph();
      break;
    case 'chord-diagram':
      initializeChordDiagram();
      break;
    case 'sunburst-chart':
      initializeSunburstChart();
      break;
    case 'timeline-chart':
      initializeTimelineChart();
      break;
    case 'relationship-heatmap':
      initializeRelationshipHeatmap();
      break;
  }
}

function ensureFullscreenOverlay() {
  let overlay = document.getElementById('fullscreen-overlay');
  if (!overlay) {
    overlay = document.createElement('div');
    overlay.id = 'fullscreen-overlay';
    overlay.className = 'fixed inset-0 z-50 hidden';
    overlay.style.background = '#000';
    overlay.innerHTML = `
      <div class="absolute top-3 right-3 flex items-center gap-2">
        <button onclick="exitFullscreen()" class="text-gray-300 hover:text-white p-2" aria-label="Close fullscreen">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div id="fullscreen-title" class="absolute top-3 left-3 text-white text-lg font-semibold px-3 py-2 bg-black/0"></div>
      <div id="fullscreen-container" class="w-full h-full p-4">
        <div id="fullscreen-slot" class="w-full h-full rounded-lg" style="background:#000;"></div>
      </div>
    `;
    document.body.appendChild(overlay);

    // ESC to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') exitFullscreen();
    });
  }
  return overlay;
}

function chartTitleById(id) {
  switch (id) {
    case 'network-graph':
      return 'Knowledge Network Topology';
    case 'chord-diagram':
      return 'Inter-Pool Relationship Flows';
    case 'sunburst-chart':
      return 'Knowledge Distribution';
    case 'timeline-chart':
      return 'Temporal Distribution';
    case 'relationship-heatmap':
      return 'Relationship Matrix & Patterns';
    default:
      return 'Visualization';
  }
}

function enterFullscreen(targetId) {
  const el = document.getElementById(targetId);
  if (!el) return;

  const overlay = ensureFullscreenOverlay();
  const slot = overlay.querySelector('#fullscreen-slot');

  // Save restore info only once
  if (!__fsRestore[targetId]) {
    __fsRestore[targetId] = { parent: el.parentNode, next: el.nextSibling };
  }

  // Resize target to fit and force opaque background
  el.style.width = '100%';
  el.style.height = 'calc(100vh - 64px)';
  el.style.background = '#000';

  // Save and override classes to remove any translucent backgrounds/heights
  if (!el.dataset.originalClass)
    el.dataset.originalClass = el.className;
  // Remove any Tailwind bg-* class and h-64/80/96 classes
  const cleaned = el.className
    .replace(/bg-[^\s]+/g, '')
    .replace(/h-(64|80|96)/g, '')
    .replace(/\s+/g, ' ') // collapse
    .trim();
  el.className = `${cleaned} bg-black h-full w-full rounded-lg flex items-center justify-center`;

  // Move node into overlay slot
  slot.innerHTML = '';
  slot.appendChild(el);

  // Show overlay
  overlay.classList.remove('hidden');
  document.body.style.overflow = 'hidden';

  // Set title
  const titleEl = document.getElementById('fullscreen-title');
  if (titleEl) titleEl.textContent = chartTitleById(targetId);

  // Re-render chart for new size
  reinitializeChart(targetId);
}

function exitFullscreen() {
  const overlay = document.getElementById('fullscreen-overlay');
  if (!overlay || overlay.classList.contains('hidden')) return;
  const slot = overlay.querySelector('#fullscreen-slot');
  const child = slot.firstElementChild;
  if (child && __fsRestore[child.id]) {
    const { parent, next } = __fsRestore[child.id];
    // Restore chart container to original position
    if (next && next.parentNode === parent) {
      parent.insertBefore(child, next);
    } else {
      parent.appendChild(child);
    }
    // Reset inline styles
    child.style.width = '';
    child.style.height = '';
    // Restore original classes and background
    if (child.dataset.originalClass) {
      child.className = child.dataset.originalClass;
      delete child.dataset.originalClass;
    }
    child.style.background = '';
    // Re-render back in original size
    reinitializeChart(child.id);
  }
  overlay.classList.add('hidden');
  document.body.style.overflow = '';
}

function closeEntityModal() {
  document.getElementById('entity-modal').classList.add('hidden');
}

// ProvenanceAndRights filter toggle
function toggleProvenanceFilter(includeProvenance) {
  console.log('Toggling provenance filter:', includeProvenance);
  
  // Show loading indicator
  const banner = document.querySelector('.bg-gradient-to-r.from-indigo-600\\/30');
  if (banner) {
    const loadingDiv = document.createElement('div');
    loadingDiv.id = 'filter-loading';
    loadingDiv.className = 'text-center py-2';
    loadingDiv.innerHTML = '<div class="text-sm text-gray-300">🔄 Updating dashboard with new filter settings...</div>';
    banner.appendChild(loadingDiv);
  }
  
  // Reload dashboard with new filter parameter
  const currentUrl = new URL(window.location);
  if (includeProvenance) {
    currentUrl.searchParams.set('include_provenance', 'true');
  } else {
    currentUrl.searchParams.delete('include_provenance');
  }
  
  // Reload the page with the new parameter
  window.location.href = currentUrl.toString();
}

// Analytics Analysis toggle with localStorage persistence
function toggleAnalysis() {
