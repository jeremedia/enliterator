// Initialize Analytics Analysis collapse state from localStorage
function initializeAnalysisState() {
  const content = document.getElementById('analysis-content');
  const chevron = document.getElementById('analysis-chevron');
  const isExpanded = localStorage.getItem('analysis-expanded');
  
  // Default to expanded if no preference stored
