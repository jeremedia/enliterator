  const margin = { top: 60, right: 40, bottom: 60, left: 80 };
  const width = container.clientWidth - margin.left - margin.right;
  const height = container.clientHeight - margin.top - margin.bottom;
  
  // Clear existing content
  container.innerHTML = '';
  
  const svg = d3.select('#relationship-heatmap')
    .append('svg')
    .attr('width', container.clientWidth)
    .attr('height', container.clientHeight);
    
  const g = svg.append('g')
    .attr('transform', `translate(${margin.left},${margin.top})`);
  
  const pools = relationshipHeatmapData.pools;
  const matrixData = relationshipHeatmapData.matrix;
  const metadata = relationshipHeatmapData.metadata;
  const includeProvenance = <%= @include_provenance ? 'true' : 'false' %>;
  
  console.log('Matrix data:', { pools: pools.length, cells: matrixData.length, maxFreq: metadata.max_frequency });
  
  // Calculate cell dimensions
  const cellSize = Math.min(width / pools.length, height / pools.length) * 0.8;
  const cellPadding = cellSize * 0.1;
  
  // Arctic-themed color scale for frequency
  const colorScale = d3.scaleSequential(d3.interpolateBlues)
    .domain([0, metadata.max_frequency || 1]);
  
  // Special colors for relationship types
  const typeColors = {
    'INFLUENCES': '#FF6B6B',
    'CONNECTS_TO': '#4ECDC4', 
    'HAS_RIGHTS': '#9CA3AF',
    'CONTAINS': '#FECA57',
    'RELATES_TO': '#A78BFA'
  };
  
  // Create scales for positioning
  const xScale = d3.scaleBand()
    .domain(pools)
    .range([0, Math.min(width, pools.length * (cellSize + cellPadding))])
    .padding(0.1);
    
  const yScale = d3.scaleBand()
    .domain(pools)
    .range([0, Math.min(height, pools.length * (cellSize + cellPadding))])
    .padding(0.1);
  
  // Create matrix cells
  const cells = g.selectAll('.matrix-cell')
    .data(matrixData)
    .enter().append('g')
    .attr('class', 'matrix-cell')
    .attr('transform', d => `translate(${xScale(d.target_pool)}, ${yScale(d.source_pool)})`);
  
  // Draw cell rectangles with adaptive coloring
  cells.append('rect')
    .attr('width', xScale.bandwidth())
    .attr('height', yScale.bandwidth())
    .attr('rx', 4)
    .attr('fill', d => {
      // Use relationship type color for system relationships, frequency color for conceptual
      if (d.dominant_type === 'HAS_RIGHTS') {
        return typeColors['HAS_RIGHTS'];
      } else if (d.dominant_type in typeColors) {
        return typeColors[d.dominant_type];
      } else {
        return colorScale(d.frequency);
      }
    })
    .attr('stroke', d => d.is_bidirectional ? '#FFD700' : '#1f2937')
    .attr('stroke-width', d => d.is_bidirectional ? 3 : 1)
    .attr('opacity', 0.8)
    .style('cursor', 'pointer')
    .on('mouseover', function(event, d) {
      showMatrixTooltip(event, d);
      d3.select(this)
        .transition().duration(200)
        .attr('opacity', 1)
        .attr('stroke-width', d => d.is_bidirectional ? 4 : 2);
    })
    .on('mouseout', function(event, d) {
      hideMatrixTooltip();
      d3.select(this)
        .transition().duration(200)
        .attr('opacity', 0.8)
        .attr('stroke-width', d => d.is_bidirectional ? 3 : 1);
    });
  
  // Add frequency text in cells (for significant relationships)
  cells.append('text')
    .attr('x', xScale.bandwidth() / 2)
    .attr('y', yScale.bandwidth() / 2)
    .attr('text-anchor', 'middle')
    .attr('dominant-baseline', 'middle')
    .attr('font-size', Math.max(10, xScale.bandwidth() * 0.2))
    .attr('font-weight', 'bold')
    .attr('fill', d => {
      // White text for dark cells, dark text for light cells
      const bgColor = d3.color(d.dominant_type === 'HAS_RIGHTS' ? typeColors['HAS_RIGHTS'] : colorScale(d.frequency));
      return d3.hsl(bgColor).l > 0.5 ? '#000' : '#fff';
    })
    .text(d => d.frequency > (metadata.max_frequency * 0.1) ? d.frequency : '')
    .style('pointer-events', 'none');
  
  // Add bidirectional indicators
  cells.filter(d => d.is_bidirectional)
    .append('circle')
    .attr('cx', xScale.bandwidth() - 8)
    .attr('cy', 8)
    .attr('r', 4)
    .attr('fill', '#FFD700')
    .attr('stroke', '#000')
    .attr('stroke-width', 1)
    .style('pointer-events', 'none');
  
  // X-axis labels (target pools)
  g.append('g')
    .attr('class', 'x-axis')
    .selectAll('text')
    .data(pools)
    .enter().append('text')
    .attr('x', d => xScale(d) + xScale.bandwidth() / 2)
    .attr('y', -10)
    .attr('text-anchor', 'middle')
    .attr('font-size', '12px')
    .attr('font-weight', 'bold')
    .attr('fill', '#E5E7EB')
    .text(d => d);
  
  // Y-axis labels (source pools)
  g.append('g')
    .attr('class', 'y-axis')
    .selectAll('text')
    .data(pools)
    .enter().append('text')
    .attr('x', -10)
    .attr('y', d => yScale(d) + yScale.bandwidth() / 2)
    .attr('text-anchor', 'end')
    .attr('dominant-baseline', 'middle')
    .attr('font-size', '12px')
    .attr('font-weight', 'bold')
    .attr('fill', '#E5E7EB')
    .text(d => d);
  
  // Add axis labels
  g.append('text')
    .attr('x', Math.min(width, pools.length * (cellSize + cellPadding)) / 2)
    .attr('y', -35)
    .attr('text-anchor', 'middle')
    .attr('font-size', '14px')
    .attr('font-weight', 'bold')
    .attr('fill', '#9CA3AF')
    .text('Target Pool');
  
  g.append('text')
    .attr('x', -40)
    .attr('y', Math.min(height, pools.length * (cellSize + cellPadding)) / 2)
    .attr('text-anchor', 'middle')
    .attr('dominant-baseline', 'middle')
    .attr('font-size', '14px')
    .attr('font-weight', 'bold')
    .attr('fill', '#9CA3AF')
    .attr('transform', `rotate(-90, -40, ${Math.min(height, pools.length * (cellSize + cellPadding)) / 2})`)
    .text('Source Pool');
  
  // Add legend
  const legend = g.append('g')
    .attr('class', 'legend')
    .attr('transform', `translate(${Math.min(width, pools.length * (cellSize + cellPadding)) + 20}, 20)`);
  
  // Frequency legend
  legend.append('text')
    .attr('x', 0)
    .attr('y', 0)
    .attr('font-size', '12px')
    .attr('font-weight', 'bold')
    .attr('fill', '#9CA3AF')
    .text('Relationship Strength');
  
  const legendScale = d3.scaleLinear()
    .domain([0, metadata.max_frequency || 1])
    .range([0, 100]);
    
  const legendAxis = d3.axisRight(legendScale)
    .ticks(4)
    .tickFormat(d3.format('d'));
  
  const legendGradient = legend.append('defs')
    .append('linearGradient')
    .attr('id', 'legend-gradient')
    .attr('x1', '0%').attr('y1', '0%')
    .attr('x2', '0%').attr('y2', '100%');
    
  legendGradient.selectAll('stop')
    .data(colorScale.range())
    .enter().append('stop')
    .attr('offset', (d, i) => `${i * 100 / (colorScale.range().length - 1)}%`)
    .attr('stop-color', d => d);
  
  legend.append('rect')
    .attr('x', 0)
    .attr('y', 10)
    .attr('width', 20)
    .attr('height', 100)
    .style('fill', 'url(#legend-gradient)');
    
  legend.append('g')
    .attr('transform', 'translate(20, 10)')
    .call(legendAxis)
    .selectAll('text')
    .attr('fill', '#9CA3AF')
    .attr('font-size', '10px');
  
  // Special indicators legend
  if (metadata.bidirectional_count > 0) {
    legend.append('circle')
      .attr('cx', 10)
      .attr('cy', 140)
      .attr('r', 4)
      .attr('fill', '#FFD700')
      .attr('stroke', '#000')
      .attr('stroke-width', 1);
      
    legend.append('text')
      .attr('x', 20)
      .attr('y', 145)
      .attr('font-size', '10px')
      .attr('fill', '#9CA3AF')
      .text('Bidirectional');
  }
  
  // Add metadata summary
  const summaryY = includeProvenance ? 170 : 160;
  const densityPercent = (metadata.density * 100).toFixed(1);
  
  legend.append('text')
    .attr('x', 0)
    .attr('y', summaryY)
    .attr('font-size', '10px')
    .attr('font-weight', 'bold')
    .attr('fill', '#6B7280')
    .text('Matrix Statistics');
    
  legend.append('text')
    .attr('x', 0)
    .attr('y', summaryY + 15)
    .attr('font-size', '9px')
    .attr('fill', '#9CA3AF')
    .text(`Density: ${densityPercent}%`);
    
  legend.append('text')
    .attr('x', 0)
    .attr('y', summaryY + 28)
    .attr('font-size', '9px')
    .attr('fill', '#9CA3AF')
    .text(`Patterns: ${matrixData.length}`);
    
  if (!includeProvenance) {
    legend.append('text')
      .attr('x', 0)
      .attr('y', summaryY + 41)
      .attr('font-size', '8px')
      .attr('fill', '#F59E0B')
      .text('P&R filtered');
  }
}

// Matrix tooltip functions
function showMatrixTooltip(event, data) {
  const tooltip = document.createElement('div');
  tooltip.id = 'matrix-tooltip';
  tooltip.style.cssText = `
    position: fixed;
    background: rgba(0,0,0,0.95);
    color: white;
    padding: 12px;
    border-radius: 8px;
    font-size: 12px;
    pointer-events: none;
    z-index: 1000;
    max-width: 300px;
    border: 1px solid rgba(255,255,255,0.2);
  `;
  
  const directionIcon = data.is_bidirectional ? '↔️' : '→';
  const relationshipsList = data.relationship_types.join('<br>• ');
  
  tooltip.innerHTML = `
    <div class="font-bold text-white mb-2">
      ${directionIcon} ${data.source_pool} → ${data.target_pool}
    </div>
    <div class="text-gray-300 text-sm mb-2">
      <strong>Frequency:</strong> ${data.frequency} relationships
    </div>
    <div class="text-gray-300 text-xs">
      <strong>Types:</strong><br>• ${relationshipsList}
    </div>
    ${data.is_bidirectional ? '<div class="text-yellow-400 text-xs mt-2">⭐ Bidirectional Flow</div>' : ''}
  `;
  
  tooltip.style.left = (event.pageX + 10) + 'px';
  tooltip.style.top = (event.pageY - 10) + 'px';
  document.body.appendChild(tooltip);
}

function hideMatrixTooltip() {
  const tooltip = document.getElementById('matrix-tooltip');
  if (tooltip) tooltip.remove();
}

// Auto-refresh functionality (every 5 minutes)
setInterval(() => {
  console.log('Dashboard auto-refresh triggered');
  // window.location.reload();
}, 300000);
</script>

