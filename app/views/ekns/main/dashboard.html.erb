// Clear heavy DOM before Turbo caches the page so we always paint fresh graphs
function cleanupDashboard() {
  ['network-graph','chord-diagram','sunburst-chart','timeline-chart','relationship-heatmap'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = '';
  });
}
document.addEventListener('turbo:before-cache', cleanupDashboard);

// Network Graph Implementation
function initializeNetworkGraph() {
  console.log('Initializing Arctic Research knowledge map with', networkData.nodes?.length, 'nodes');
  
  if (!networkData.nodes || networkData.nodes.length === 0) {
    document.getElementById('network-graph').innerHTML = '<div class="text-gray-400">No Arctic research network data available</div>';
    return;
  }
  
  // Display insights about the network
  if (networkData.insights) {
    displayNetworkInsights(networkData.insights);
  }
  
  // Analyze network composition for Arctic Research insights
  const poolCounts = networkData.nodes.reduce((acc, node) => {
    acc[node.pool] = (acc[node.pool] || 0) + 1;
    return acc;
  }, {});
  
  const arcticConcepts = networkData.nodes.filter(n => n.node_type === 'domain_concept').length;
  const bridgeNodes = networkData.nodes.filter(n => n.inter_pool_connections > 0).length;
  
  console.log('Arctic Research Network:', {
    pools: poolCounts,
    arctic_concepts: arcticConcepts,
    bridge_nodes: bridgeNodes,
    links: networkData.links.length
  });
  
  const container = document.getElementById('network-graph');
  const width = container.clientWidth;
  const height = container.clientHeight;
  
  // Clear existing content
  container.innerHTML = '';
  
  const svg = d3.select('#network-graph')
    .append('svg')
    .attr('width', width)
    .attr('height', height);
  
  // Create force simulation with boundary constraints
  const margin = 30;
  const simulation = d3.forceSimulation(networkData.nodes)
    .force('link', d3.forceLink(networkData.links).id(d => d.id).distance(40).strength(0.3))
    .force('charge', d3.forceManyBody().strength(-80))
    .force('center', d3.forceCenter(width / 2, height / 2))
    .force('collision', d3.forceCollide().radius(d => Math.sqrt(d.connections || 1) * 2 + 5))
    // Add boundary forces to keep nodes in view
    .force('x', d3.forceX(width / 2).strength(0.1))
    .force('y', d3.forceY(height / 2).strength(0.1));
  
  // Create links
  const link = svg.append('g')
    .selectAll('line')
    .data(networkData.links)
    .enter().append('line')
    .attr('stroke', '#999')
    .attr('stroke-opacity', 0.4)
    .attr('stroke-width', 1);
  
  // Create nodes with pool-based colors and adaptive sizing
  const poolColors = {
    'Idea': '#60A5FA',
    'Practical': '#34D399', 
    'Experience': '#FBBF24',
    'Manifest': '#F87171',
    'Character': '#A78BFA',
    'Time': '#FB7185',
    'Space': '#38BDF8',
    'Lifecycle': '#4ADE80',
    'Symbolic': '#C084FC',
    'Relator': '#F59E0B',
    'Lexicon': '#6B7280',
    'ProvenanceAndRights': '#9CA3AF'
  };
  
  // Adaptive node sizing based on connection count and filter state
  const maxConnections = Math.max(...networkData.nodes.map(n => n.connections || 1));
  const includeProvenance = <%= @include_provenance ? 'true' : 'false' %>;
  
  function getNodeRadius(connections) {
    if (includeProvenance) {
      // With provenance: wider range for high-connection system nodes
      return Math.min(Math.max(4, Math.sqrt(connections) * 1.5), 15);
    } else {
      // Without provenance: more uniform sizing for conceptual nodes
      return Math.min(Math.max(5, connections * 1.2 + 4), 12);
    }
  }
  
  // Create node groups for circles and labels
  const nodeGroups = svg.append('g')
    .selectAll('g')
    .data(networkData.nodes)
    .enter().append('g')
    .attr('class', 'node-group')
    .style('cursor', 'pointer')
    .call(drag(simulation))
    .on('click', function(event, d) {
      showEntityDetails(d.id);
    });
  
  // Add circles to node groups
  const node = nodeGroups.append('circle')
    .attr('r', d => getNodeRadius(d.connections || 1))
    .attr('fill', d => {
      // Special coloring for Arctic domain concepts
      if (d.node_type === 'domain_concept') {
        return '#EF4444';  // Red for Arctic concepts
      }
      return poolColors[d.pool] || '#6B7280';
    })
    .attr('stroke', d => {
      // Special styling for inter-pool bridge nodes (high value)
      const hasInterPool = d.inter_pool_connections > 0;
      const isArcticConcept = d.node_type === 'domain_concept';
      if (isArcticConcept) return '#FFD700';  // Gold for Arctic concepts
      return hasInterPool ? '#FFD700' : '#fff';
    })
    .attr('stroke-width', d => {
      const hasInterPool = d.inter_pool_connections > 0;
      const isArcticConcept = d.node_type === 'domain_concept';
      if (isArcticConcept) return 3;  // Thicker border for Arctic concepts
      return hasInterPool ? 2.5 : 1.5;
    })
    .on('mouseover', function(event, d) {
      const baseRadius = getNodeRadius(d.connections || 1);
      d3.select(this).transition().duration(200).attr('r', baseRadius * 1.3);
      
      // Show enhanced tooltip for Arctic concepts
      showNetworkTooltip(event, d);
    })
    .on('mouseout', function(event, d) {
      d3.select(this).transition().duration(200).attr('r', getNodeRadius(d.connections || 1));
      hideNetworkTooltip();
    });
    
  // Add labels for important nodes (Arctic concepts and high-connection nodes)
  const nodeLabels = nodeGroups.filter(d => {
    return d.node_type === 'domain_concept' || d.connections >= 5;
  }).append('text')
    .attr('dx', 0)
    .attr('dy', d => getNodeRadius(d.connections || 1) + 14)
    .attr('text-anchor', 'middle')
    .attr('font-size', '9px')
    .attr('font-weight', 'bold')
    .attr('fill', '#E5E7EB')
    .attr('stroke', '#1F2937')
    .attr('stroke-width', '0.5px')
    .style('pointer-events', 'none')
    .text(d => {
      const label = d.label || 'Unknown';
      // Truncate long labels
      return label.length > 12 ? label.substring(0, 12) + '...' : label;
    });
  
  // Update positions on simulation tick with boundary constraints
  simulation.on('tick', () => {
    // Constrain node positions within bounds and update both circles and labels
    nodeGroups.attr('transform', d => {
      const radius = getNodeRadius(d.connections || 1);
      d.x = Math.max(margin + radius, Math.min(width - margin - radius, d.x));
      d.y = Math.max(margin + radius, Math.min(height - margin - radius, d.y));
      return `translate(${d.x},${d.y})`;
    });
    
    // Update link positions
    link
      .attr('x1', d => d.source.x)
      .attr('y1', d => d.source.y)
      .attr('x2', d => d.target.x)
      .attr('y2', d => d.target.y);
  });
  
  // Add zoom/pan functionality
  const zoom = d3.zoom()
    .scaleExtent([0.5, 3])
    .on('zoom', function(event) {
      const { transform } = event;
      svg.selectAll('g').attr('transform', transform);
    });
    
  svg.call(zoom);
}

// Drag behavior for network nodes
function drag(simulation) {
  function dragstarted(event) {
    if (!event.active) simulation.alphaTarget(0.3).restart();
    event.subject.fx = event.subject.x;
    event.subject.fy = event.subject.y;
  }
  
  function dragged(event) {
    event.subject.fx = event.x;
    event.subject.fy = event.y;
  }
  
  function dragended(event) {
    if (!event.active) simulation.alphaTarget(0);
    event.subject.fx = null;
    event.subject.fy = null;
  }
  
  return d3.drag()
    .on("start", dragstarted)
    .on("drag", dragged)
    .on("end", dragended);
}

// Pool Distribution Donut Chart
function initializeSunburstChart() {
  console.log('Initializing sunburst chart with', poolDistribution.length, 'pools');
  
  if (!poolDistribution || poolDistribution.length === 0) {
    document.getElementById('sunburst-chart').innerHTML = '<div class="text-gray-400">No pool data available</div>';
    return;
  }
  
  const container = document.getElementById('sunburst-chart');
  const width = container.clientWidth;
  const height = container.clientHeight;
  const radius = Math.min(width, height) / 2 - 20;
  
  container.innerHTML = '';
  
  const svg = d3.select('#sunburst-chart')
    .append('svg')
    .attr('width', width)
    .attr('height', height)
    .append('g')
    .attr('transform', `translate(${width/2},${height/2})`);
  
  // Color scale
  const color = d3.scaleOrdinal()
    .domain(poolDistribution.map(d => d.pool))
    .range(['#60A5FA', '#34D399', '#FBBF24', '#F87171', '#A78BFA', '#FB7185', '#38BDF8', '#4ADE80', '#C084FC', '#F59E0B']);
  
  // Pie generator
  const pie = d3.pie()
    .value(d => d.count)
    .sort(null);
  
  // Arc generator
  const arc = d3.arc()
    .innerRadius(radius * 0.4)
    .outerRadius(radius);
  
  // Create arcs
  const arcs = svg.selectAll('.arc')
    .data(pie(poolDistribution))
    .enter().append('g')
    .attr('class', 'arc');
  
  arcs.append('path')
    .attr('d', arc)
    .attr('fill', d => color(d.data.pool))
    .attr('stroke', '#1f2937')
    .attr('stroke-width', 2)
    .style('cursor', 'pointer')
    .on('mouseover', function(event, d) {
      d3.select(this).transition()
        .duration(200)
        .attr('transform', 'scale(1.05)');
    })
    .on('mouseout', function(event, d) {
      d3.select(this).transition()
        .duration(200)
        .attr('transform', 'scale(1)');
    });
  
  // Add labels
  arcs.append('text')
    .attr('transform', d => `translate(${arc.centroid(d)})`)
    .attr('text-anchor', 'middle')
    .attr('font-size', '12px')
    .attr('fill', 'white')
    .attr('font-weight', 'bold')
    .text(d => d.data.count > 100 ? d.data.pool : '');
}

// Proper D3.js Chord Diagram Implementation
function initializeChordDiagram() {
  console.log('Initializing chord diagram with data:', chordData);
  console.log('D3 chord available:', typeof d3.chord);
  console.log('D3 ribbon available:', typeof d3.ribbon);
  
  // Check if d3.chord is available
  if (typeof d3.chord === 'undefined') {
    console.error('d3.chord is not available. Loading fallback visualization.');
    document.getElementById('chord-diagram').innerHTML = '<div class="text-center text-gray-400 mt-20">Knowledge Flow Analysis<br><span class="text-sm">D3.js chord module loading... Please refresh if this persists</span></div>';
    return;
  }
  
  if (!chordData.pools || chordData.pools.length === 0) {
    document.getElementById('chord-diagram').innerHTML = '<div class="text-center text-gray-400 mt-20">Knowledge Isolation Pattern<br><span class="text-sm">No inter-pool connections detected</span></div>';
    return;
  }
  
  const container = document.getElementById('chord-diagram');
  const width = container.clientWidth;
  const height = container.clientHeight;
  const outerRadius = Math.min(width, height) * 0.4;
  const innerRadius = outerRadius - 15;
  
  // Clear existing content
  container.innerHTML = '';
  
  const svg = d3.select('#chord-diagram')
    .append('svg')
    .attr('width', width)
    .attr('height', height)
    .append('g')
    .attr('transform', `translate(${width/2},${height/2})`);
  
  // Arctic-themed color palette for pools
  const poolColors = {
    'Idea': '#FF6B6B',        // Warm red - generative energy
    'Practical': '#4ECDC4',   // Cool teal - practical application  
    'Experience': '#45B7D1',  // Blue - deep knowledge
    'Manifest': '#FEA47F',    // Orange - tangible results
    'Character': '#A78BFA',   // Purple - human elements
    'Time': '#FF9FF3',        // Pink - temporal context
    'Space': '#54A0FF',       // Blue - spatial context
    'Lifecycle': '#5F27CD',   // Deep purple - processes
    'Symbolic': '#96CEB4',    // Mint - abstract concepts
    'Relator': '#00D2D3',     // Cyan - connections
    'Lexicon': '#FECA57'      // Golden yellow - knowledge base
  };
  
  // Color scale for pools
  const color = d3.scaleOrdinal()
    .domain(chordData.pools)
    .range(chordData.pools.map(pool => poolColors[pool] || '#6B7280'));
  
  // D3 chord layout - this is the proper way!
  const chord = d3.chord()
    .padAngle(0.02)  // Small padding between arcs
    .sortSubgroups(d3.descending)
    .sortChords(d3.descending);
  
  // Arc generator for outer rings
  const arc = d3.arc()
    .innerRadius(innerRadius)
    .outerRadius(outerRadius);
    
  // Ribbon generator for inner connections  
  const ribbon = d3.ribbon()
    .radius(innerRadius - 2);
  
  // Generate chords from matrix
  const chords = chord(chordData.matrix);
  console.log('Generated chords:', chords);
  
  // Draw the arcs (outer pools)
  const groups = svg.append('g')
    .selectAll('g')
    .data(chords.groups)
    .enter().append('g');
  
  // Pool arcs
  groups.append('path')
    .attr('d', arc)
    .attr('fill', d => color(chordData.pools[d.index]))
    .attr('stroke', '#1f2937')
    .attr('stroke-width', 2)
    .style('cursor', 'pointer')
    .on('mouseover', function(event, d) {
      const poolName = chordData.pools[d.index];
      const poolStats = chordData.metadata?.pool_stats?.[poolName];
      
      // Highlight ribbons connected to this pool
      svg.selectAll('.chord-ribbon')
        .style('opacity', chord => (chord.source.index === d.index || chord.target.index === d.index) ? 0.8 : 0.1);
        
      // Show tooltip
      showChordTooltip(event, poolName, poolStats, d);
      
      // Slightly expand arc
      d3.select(this).transition().duration(200)
        .attr('d', d3.arc().innerRadius(innerRadius - 3).outerRadius(outerRadius + 3));
    })
    .on('mouseout', function(event, d) {
      // Reset ribbon opacity
      svg.selectAll('.chord-ribbon').style('opacity', 0.6);
      hideChordTooltip();
      
      // Reset arc size
      d3.select(this).transition().duration(200).attr('d', arc);
    });
  
  // Pool labels with smart positioning
  groups.append('text')
    .each(d => { d.angle = (d.startAngle + d.endAngle) / 2; })
    .attr('dy', '.35em')
    .attr('transform', d => `
      rotate(${(d.angle * 180 / Math.PI - 90)})
      translate(${outerRadius + 15})
      ${d.angle > Math.PI ? 'rotate(180)' : ''}
    `)
    .style('text-anchor', d => d.angle > Math.PI ? 'end' : 'start')
    .attr('font-size', '12px')
    .attr('font-weight', 'bold')
    .attr('fill', 'white')
    .text(d => chordData.pools[d.index]);
  
  // Draw ribbons (connections between pools)
  if (chords.length > 0) {
    svg.append('g')
      .attr('fill-opacity', 0.6)
      .selectAll('path')
      .data(chords)
      .enter().append('path')
      .attr('class', 'chord-ribbon')
      .attr('d', ribbon)
      .attr('fill', d => color(chordData.pools[d.source.index]))
      .attr('stroke', d => d3.rgb(color(chordData.pools[d.source.index])).darker(0.5))
      .attr('stroke-width', '0.5px')
      .style('cursor', 'pointer')
      .on('mouseover', function(event, d) {
        const sourcePool = chordData.pools[d.source.index];
        const targetPool = chordData.pools[d.target.index];
        const flowKey = `${sourcePool}→${targetPool}`;
        const flowData = chordData.flows?.[flowKey];
        
        // Highlight this ribbon
        d3.select(this).style('fill-opacity', 0.9);
        
        // Show flow tooltip
        showFlowTooltip(event, sourcePool, targetPool, flowData, d);
      })
      .on('mouseout', function(event, d) {
        d3.select(this).style('fill-opacity', 0.6);
        hideChordTooltip();
      });
  }
  
  // Add central insight message
  const totalFlows = chords.length;
  const centerGroup = svg.append('g')
    .attr('text-anchor', 'middle')
    .attr('font-family', 'system-ui, sans-serif');
  
  if (totalFlows <= 1) {
    centerGroup.append('text')
      .attr('font-size', '14px')
      .attr('font-weight', 'bold')
      .attr('fill', '#9CA3AF')
      .attr('y', -20)
      .text('Knowledge Islands');
      
    centerGroup.append('text') 
      .attr('font-size', '12px')
      .attr('fill', '#6B7280')
      .attr('y', 0)
      .text('Architecture');
      
    centerGroup.append('text')
      .attr('font-size', '10px')
      .attr('fill', '#6B7280')
      .attr('y', 15)
      .text(`${chordData.pools.length} pools`);
      
    centerGroup.append('text')
      .attr('font-size', '10px')
      .attr('fill', '#6B7280')
      .attr('y', 28)
      .text(`${totalFlows} bridge${totalFlows !== 1 ? 's' : ''}`);
  } else {
    centerGroup.append('text')
      .attr('font-size', '12px')
      .attr('font-weight', 'bold')
      .attr('fill', '#9CA3AF')
      .attr('y', -10)
      .text('Knowledge Flows');
      
    centerGroup.append('text')
      .attr('font-size', '10px')
      .attr('fill', '#6B7280')
      .attr('y', 10)
      .text(`${totalFlows} active connections`);
  }
}

