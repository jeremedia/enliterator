<% content_for :title, "#{@ekn.name} - Analytics Dashboard" %>
<% content_for :description, "Comprehensive analytics dashboard for #{@ekn.name} showing network topology, relationship patterns, and knowledge distribution across #{@stats[:pool_counts].keys.size} conceptual pools." %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<!-- Import D3.js and other visualization libraries -->
<%= javascript_importmap_tags %>
<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/d3-chord@3"></script>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-indigo-900 text-white">
  <!-- Dashboard Header -->
  <div class="border-b border-white/10 bg-black/20 backdrop-blur-sm sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
            <%= @ekn.name %> Analytics
          </h1>
          <p class="text-gray-300 mt-1">Knowledge Network Dashboard</p>
        </div>
        
        <div class="flex items-center gap-4">
          <!-- ProvenanceAndRights Filter -->
          <div class="flex items-center gap-2 px-3 py-2 bg-white/10 rounded-lg">
            <input type="checkbox" 
                   id="include-provenance" 
                   class="rounded border-gray-500 bg-white/10 text-blue-600 focus:ring-blue-500 focus:ring-offset-0" 
                   <%= "checked" if @include_provenance %>
                   onchange="toggleProvenanceFilter(this.checked)">
            <label for="include-provenance" class="text-sm text-gray-300 cursor-pointer select-none">
              Include ProvenanceAndRights
              <% unless @include_provenance %>
                <span class="text-xs text-orange-400 ml-1">(filtered)</span>
              <% end %>
            </label>
          </div>
          
          <%= link_to ekn_path(ekn_slug: @ekn.slug), 
                      class: "px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg transition-colors text-white" do %>
            ← Back to Overview
          <% end %>
          
          <%= link_to imports_path(ekn_slug: @ekn.slug),
                      class: "px-6 py-2 bg-white/10 hover:bg-white/20 rounded-lg transition-colors text-white" do %>
            Detailed Import Stats
          <% end %>

          <%= link_to chat_index_path(ekn_slug: @ekn.slug), 
                      class: "px-6 py-2 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 rounded-lg transition-colors font-medium" do %>
            Start Conversation
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Real-time Stats Banner -->
  <div class="bg-gradient-to-r from-indigo-600/30 to-purple-600/30 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4">
        <div class="text-center">
          <div class="text-3xl font-bold text-blue-400"><%= number_with_delimiter(@stats[:total_nodes]) %></div>
          <div class="text-sm text-gray-300">Total Entities</div>
        </div>
        
        <div class="text-center">
          <div class="text-3xl font-bold text-purple-400"><%= number_with_delimiter(@stats[:total_relationships]) %></div>
          <div class="text-sm text-gray-300">Relationships</div>
        </div>
        
        <div class="text-center">
          <div class="text-3xl font-bold text-emerald-400"><%= number_with_delimiter(@stats[:total_documents]) %></div>
          <div class="text-sm text-gray-300">Documents</div>
        </div>
        
        <div class="text-center">
          <div class="text-3xl font-bold text-orange-400"><%= number_with_delimiter(@stats[:pipeline_runs]) %></div>
          <div class="text-sm text-gray-300">Pipeline Runs</div>
        </div>
        
        <div class="text-center">
          <div class="text-3xl font-bold text-indigo-400"><%= (@stats[:density] * 100).round(2) %>%</div>
          <div class="text-sm text-gray-300 flex items-center gap-1 justify-center">
            <span>Network Density</span>
            <button type="button" aria-label="What is Network Density?" onclick="showDensityInfo(event)" class="text-gray-400 hover:text-gray-200">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 100-2 1 1 0 000 2zm-1 2a1 1 0 012 0v5a1 1 0 11-2 0v-5z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        </div>
        
        <div class="text-center">
          <div class="text-3xl font-bold text-cyan-400"><%= @stats[:avg_connections] %></div>
          <div class="text-sm text-gray-300">Avg Connections</div>
        </div>
        
        <div class="text-center">
          <div class="text-3xl font-bold text-pink-400"><%= @stats[:connected_components] %></div>
          <div class="text-sm text-gray-300">Components</div>
        </div>
        
        <div class="text-center">
          <div class="text-3xl font-bold text-yellow-400"><%= @stats[:temporal_density] %>%</div>
          <div class="text-sm text-gray-300">Temporal Coverage</div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Meta-Enliterator Analytics Analysis -->
  <div class="bg-gradient-to-r from-amber-900/20 to-orange-900/20 border-b border-amber-500/20">
    <div class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-amber-400 to-orange-500 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        
        <div class="flex-1">
          <button onclick="toggleAnalysis()" class="flex items-center justify-between w-full text-left focus:outline-none group">
            <h3 class="text-lg font-bold text-amber-400 group-hover:text-amber-300 transition-colors">
              🧠 Meta-Enliterator Analytics Analysis
            </h3>
            <svg id="analysis-chevron" class="w-5 h-5 text-amber-400 transform transition-transform duration-200" 
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <div id="analysis-content" class="mt-4 space-y-4">
            <div class="grid md:grid-cols-2 gap-6 text-base">
              <div>
                <h4 class="font-semibold text-amber-300 mb-3 text-lg">🔍 Current Pipeline Assessment</h4>
                <p class="text-gray-300 leading-relaxed mb-4">
                  <strong>Arctic Research Navigator Status:</strong> 5,605 entities and 1,860 relationships across 6 pools reveal significant progress in Stage 5.5 Relationship Discovery. Network density of 0.0118% shows we're successfully extracting co-occurrence patterns (324), influences (105), and semantic connections (38) beyond structural rights relationships.
                </p>
                <p class="text-gray-300 leading-relaxed">
                  <strong>Key Achievement:</strong> Multi-modal relationship discovery is working - we're capturing INFLUENCES between Ideas→Practical (105 connections), CO_OCCURS_WITH semantic clustering (324), and EMBODIES concept-to-manifestation flows (48), creating the foundation for expert system capabilities.
                </p>
              </div>
              
              <div>
                <h4 class="font-semibold text-amber-300 mb-3 text-lg">🚀 Knowledge Architecture Success</h4>
                <p class="text-gray-300 leading-relaxed mb-4">
                  <strong>Proven Pipeline:</strong> 30 Arctic Research documents transformed into 5,605 entities with 9 relationship types demonstrates our zero-touch pipeline scales. The 3,056 Lexicon entities and 611 Practical entities show strong domain knowledge extraction from geopolitical research.
                </p>
                <p class="text-gray-300 leading-relaxed">
                  <strong>Next Evolution:</strong> From current 1,860 relationships to enhanced semantic bridging targeting 3,000+ connections. Fine-tuning pipeline at Stage 9 will leverage this rich knowledge graph for domain-expert conversational AI trained on Arctic research patterns.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Main Dashboard Content -->
  <div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    
    <!-- Network Visualization Row -->
    <div class="grid lg:grid-cols-2 gap-8 mb-8">
      <!-- Interactive Network Graph -->
      <div class="bg-black/40 backdrop-blur-sm rounded-xl p-6 border border-white/10">
        <h3 class="text-xl font-bold mb-4 flex items-center justify-between">
          <div class="w-3 h-3 bg-blue-400 rounded-full mr-3"></div>
          <span class="flex items-center">Arctic Research Knowledge Map</span>
          <button type="button" onclick="enterFullscreen('network-graph')" class="text-gray-300 hover:text-white" aria-label="Expand network graph">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/>
            </svg>
          </button>
        </h3>
        <div id="network-graph" class="w-full h-96 bg-black/20 rounded-lg flex items-center justify-center">
          <div class="text-gray-400">Loading interactive network...</div>
        </div>
        <div class="mt-4 space-y-3">
          <div class="text-sm text-gray-400">
            <% if @include_provenance %>
              Adaptive network showing ~75 highly connected entities across all pools.
            <% else %>
              Intelligent network prioritizing inter-pool bridges and conceptual diversity.
              <span class="text-orange-400">• ProvenanceAndRights filtered</span>
            <% end %>
            <br>Hover for details, drag to explore.
          </div>
          
          <!-- Network Insights Panel -->
          <div class="bg-gradient-to-r from-blue-900/30 to-purple-900/30 rounded-lg p-4 border border-blue-400/20">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <h5 class="text-sm font-semibold text-blue-300">Arctic Research Knowledge Map</h5>
            </div>
            <div id="network-insights" class="text-xs text-gray-300 space-y-1">
              <div class="text-blue-200">Loading Arctic research insights...</div>
            </div>
          </div>
          
          <!-- Color Key Legend -->
          <div class="bg-black/30 rounded-lg p-3 border border-white/10">
            <h5 class="text-xs font-semibold text-gray-300 mb-2">Node Types</h5>
            <div class="grid grid-cols-3 gap-x-3 gap-y-1 text-xs mb-3">
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full" style="background-color: #60A5FA"></div>
                <span class="text-gray-300">Idea</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full" style="background-color: #34D399"></div>
                <span class="text-gray-300">Practical</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full" style="background-color: #FBBF24"></div>
                <span class="text-gray-300">Experience</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full" style="background-color: #F87171"></div>
                <span class="text-gray-300">Manifest</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full" style="background-color: #A78BFA"></div>
                <span class="text-gray-300">Character</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full" style="background-color: #6B7280"></div>
                <span class="text-gray-300">Lexicon</span>
              </div>
            </div>
            <div class="space-y-1 text-xs text-gray-400 border-t border-gray-600 pt-2">
              <div class="flex items-center gap-2">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 8 8">
                  <circle cx="4" cy="4" r="3" stroke="#FFD700" stroke-width="1" fill="transparent"/>
                </svg>
                <span>Bridge nodes (cross-pool connections)</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-3 h-3 text-red-400" fill="currentColor" viewBox="0 0 8 8">
                  <circle cx="4" cy="4" r="3"/>
                </svg>
                <span>Arctic domain concepts</span>
              </div>
              <div>Size = connection count | Hover for details</div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Chord Diagram -->
      <div class="bg-black/40 backdrop-blur-sm rounded-xl p-6 border border-white/10">
        <h3 class="text-xl font-bold mb-4 flex items-center justify-between">
          <div class="w-3 h-3 bg-purple-400 rounded-full mr-3"></div>
          <span class="flex items-center">Inter-Pool Relationship Flows</span>
          <button type="button" onclick="enterFullscreen('chord-diagram')" class="text-gray-300 hover:text-white" aria-label="Expand chord diagram">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/>
            </svg>
          </button>
        </h3>
        <div id="chord-diagram" class="w-full h-96 bg-black/20 rounded-lg flex items-center justify-center">
          <div class="text-gray-400">Loading chord diagram...</div>
        </div>
        <div class="mt-4 space-y-3">
          <div class="text-sm text-gray-400">
            Relationship flows between different knowledge pools (Ten Pool Canon).
          </div>
          
          <!-- Chord Diagram Insights Panel -->
          <div class="bg-gradient-to-r from-purple-900/30 to-indigo-900/30 rounded-lg p-4 border border-purple-400/20">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 01.553-.894L9 2l6 3 6-3v15l-6 3-6-3z"/>
              </svg>
              <h5 class="text-sm font-semibold text-purple-300">Knowledge Flow Architecture</h5>
            </div>
            <div id="chord-insights" class="text-xs text-gray-300 space-y-2">
              <div class="text-purple-200">
                <strong>What This Shows:</strong> Each colored arc represents a knowledge pool (Ideas, Practical solutions, Experiences, etc.). 
                The curved ribbons show how concepts flow between pools—revealing the conceptual pathways in your Arctic research.
              </div>
              <div class="text-gray-300">
                <strong>Reading the Pattern:</strong> Thick ribbons = strong conceptual bridges. Isolated arcs = knowledge silos. 
                Balanced flows suggest mature interdisciplinary thinking, while one-way flows reveal knowledge transformation patterns.
              </div>
              <div class="grid grid-cols-2 gap-4 mt-3 pt-2 border-t border-purple-500/20 text-xs">
                <div>
                  <span class="text-purple-300 font-medium">🔄 Generator Pools:</span>
                  <span class="text-gray-300">Ideas → outflow to applications</span>
                </div>
                <div>
                  <span class="text-purple-300 font-medium">🎯 Integrator Pools:</span>
                  <span class="text-gray-300">Experience ← inflow from concepts</span>
                </div>
                <div>
                  <span class="text-purple-300 font-medium">⚖️ Balanced Pools:</span>
                  <span class="text-gray-300">Practical ↔ bidirectional flow</span>
                </div>
                <div>
                  <span class="text-purple-300 font-medium">🏝️ Island Pools:</span>
                  <span class="text-gray-300">Isolated knowledge domains</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Flow Pattern Legend -->
          <div class="bg-black/30 rounded-lg p-3 border border-white/10">
            <h5 class="text-xs font-semibold text-gray-300 mb-2">Understanding Flow Patterns</h5>
            <div class="space-y-1 text-xs text-gray-400">
              <div class="flex items-center gap-2">
                <div class="w-3 h-1 bg-gradient-to-r from-red-400 to-blue-400 rounded"></div>
                <span>Ribbon thickness = relationship strength</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 border-2 border-purple-400 rounded-full"></div>
                <span>Arc size = pool entity count</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 8 8">
                  <path d="M4,0 L6,3 L4,6 L2,3 Z"/>
                </svg>
                <span>Hover arcs/ribbons for detailed flow data</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Pool Distribution & Centrality -->
    <div class="grid lg:grid-cols-3 gap-8 mb-8">
      <!-- Pool Distribution Sunburst -->
      <div class="bg-black/40 backdrop-blur-sm rounded-xl p-6 border border-white/10">
        <h3 class="text-xl font-bold mb-4 flex items-center justify-between">
          <div class="w-3 h-3 bg-indigo-400 rounded-full mr-3"></div>
          <span class="flex items-center">Knowledge Distribution</span>
          <button type="button" onclick="enterFullscreen('sunburst-chart')" class="text-gray-300 hover:text-white" aria-label="Expand distribution chart">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/>
            </svg>
          </button>
        </h3>
        <div id="sunburst-chart" class="w-full h-80 bg-black/20 rounded-lg flex items-center justify-center">
          <div class="text-gray-400">Loading distribution...</div>
        </div>
      </div>
      
      <!-- Most Connected Entities -->
      <div class="bg-black/40 backdrop-blur-sm rounded-xl p-6 border border-white/10">
        <h3 class="text-xl font-bold mb-4 flex items-center">
          <div class="w-3 h-3 bg-yellow-400 rounded-full mr-3"></div>
          Central Entities
        </h3>
        <div class="space-y-3 max-h-80 overflow-y-auto">
          <% @top_entities.first(10).each_with_index do |entity, index| %>
            <div class="flex items-center justify-between p-3 bg-white/5 rounded-lg hover:bg-white/10 cursor-pointer transition-colors"
                 onclick="showEntityDetails(<%= entity['id'] %>)">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-full flex items-center justify-center text-black font-bold text-sm">
                  <%= index + 1 %>
                </div>
                <div>
                  <div class="font-medium truncate max-w-48"><%= entity['name'] %></div>
                  <div class="text-xs text-gray-400"><%= entity['pool']&.titleize || 'Unknown' %></div>
                </div>
              </div>
              <div class="text-right">
                <div class="font-bold text-yellow-400"><%= entity['connections'] %></div>
                <div class="text-xs text-gray-400">connections</div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      
      <!-- Relationship Types -->
      <div class="bg-black/40 backdrop-blur-sm rounded-xl p-6 border border-white/10">
        <h3 class="text-xl font-bold mb-4 flex items-center">
          <div class="w-3 h-3 bg-green-400 rounded-full mr-3"></div>
          Relationship Patterns
        </h3>
        <div class="space-y-3 max-h-80 overflow-y-auto">
          <% @stats[:relationship_types].each do |rel_type, count| %>
            <div class="flex items-center justify-between p-3 bg-white/5 rounded-lg">
              <div class="font-medium text-gray-300"><%= rel_type.humanize %></div>
              <div class="text-right">
                <div class="font-bold text-green-400"><%= number_with_delimiter(count) %></div>
                <div class="text-xs text-gray-400">
                  <%= ((count.to_f / @stats[:total_relationships]) * 100).round(1) %>%
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Temporal Analysis -->
    <div class="grid lg:grid-cols-2 gap-8 mb-8">
      <!-- Timeline Visualization -->
      <div class="bg-black/40 backdrop-blur-sm rounded-xl p-6 border border-white/10">
        <h3 class="text-xl font-bold mb-4 flex items-center justify-between">
          <div class="w-3 h-3 bg-cyan-400 rounded-full mr-3"></div>
          <span class="flex items-center">Temporal Distribution</span>
          <button type="button" onclick="enterFullscreen('timeline-chart')" class="text-gray-300 hover:text-white" aria-label="Expand timeline chart">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/>
            </svg>
          </button>
        </h3>
        <div id="timeline-chart" class="w-full h-64 bg-black/20 rounded-lg flex items-center justify-center">
          <div class="text-gray-400">Loading timeline...</div>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-gray-400">Coverage Span:</span>
            <span class="font-medium text-cyan-400 ml-2"><%= @stats[:temporal_coverage][:coverage_span] %></span>
          </div>
          <div>
            <span class="text-gray-400">Temporal Nodes:</span>
            <span class="font-medium text-cyan-400 ml-2"><%= @stats[:temporal_coverage][:temporal_nodes] %></span>
          </div>
        </div>
      </div>
      
      <!-- Advanced Metrics -->
      <div class="bg-black/40 backdrop-blur-sm rounded-xl p-6 border border-white/10">
        <h3 class="text-xl font-bold mb-4 flex items-center">
          <div class="w-3 h-3 bg-pink-400 rounded-full mr-3"></div>
          Network Topology Metrics
        </h3>
        <div class="grid grid-cols-2 gap-6">
          <div class="text-center p-4 bg-white/5 rounded-lg">
            <div class="text-2xl font-bold text-pink-400"><%= @stats[:clustering_coefficient] %></div>
            <div class="text-sm text-gray-400 mt-1">Clustering Coefficient</div>
          </div>
          
          <div class="text-center p-4 bg-white/5 rounded-lg">
            <div class="text-2xl font-bold text-indigo-400"><%= @stats[:path_lengths][:diameter] %></div>
            <div class="text-sm text-gray-400 mt-1">Network Diameter</div>
          </div>
          
          <div class="text-center p-4 bg-white/5 rounded-lg">
            <div class="text-2xl font-bold text-blue-400"><%= @stats[:path_lengths][:avg_path_length] %></div>
            <div class="text-sm text-gray-400 mt-1">Avg Path Length</div>
          </div>
          
          <div class="text-center p-4 bg-white/5 rounded-lg">
            <div class="text-2xl font-bold text-purple-400"><%= @stats[:bidirectional_ratio] %>%</div>
