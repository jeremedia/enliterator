// Knowledge Architecture Assembly Timeline
function initializeTimelineChart() {
  console.log('Initializing timeline with', timelineData.length, 'temporal events');
  
  if (!timelineData || timelineData.length === 0) {
    document.getElementById('timeline-chart').innerHTML = '<div class="text-center text-gray-400 mt-16">No temporal data available<br><span class="text-sm">Knowledge processing timeline</span></div>';
    return;
  }
  
  const container = document.getElementById('timeline-chart');
  const margin = { top: 20, right: 30, bottom: 60, left: 60 };
  const width = container.clientWidth - margin.left - margin.right;
  const height = container.clientHeight - margin.top - margin.bottom;
  
  // Clear existing content
  container.innerHTML = '';
  
  const svg = d3.select('#timeline-chart')
    .append('svg')
    .attr('width', container.clientWidth)
    .attr('height', container.clientHeight);
    
  const g = svg.append('g')
    .attr('transform', `translate(${margin.left},${margin.top})`);
  
  // Parse timestamps and prepare data
  const parseTime = d3.timeParse('%Y-%m-%d %H:%M:%S');
  const processedData = timelineData.map(d => ({
    timestamp: parseTime(d.timestamp.replace(' UTC', '')),
    total_count: d.total_count,
    pools: d.pools || {},
    formattedTime: d.timestamp
  })).filter(d => d.timestamp); // Filter out failed parses
  
  if (processedData.length === 0) {
    container.innerHTML = '<div class="text-center text-gray-400 mt-16">Timeline parsing failed<br><span class="text-sm">Invalid timestamp format</span></div>';
    return;
  }
  
  // Arctic-themed colors for pools
  const poolColors = {
    'Idea': '#FF6B6B',
    'Practical': '#4ECDC4', 
    'Experience': '#45B7D1',
    'Lexicon': '#FECA57'
  };
  
  // Create scales
  const xScale = d3.scaleTime()
    .domain(d3.extent(processedData, d => d.timestamp))
    .range([0, width]);
    
  const yScale = d3.scaleLinear()
    .domain([0, d3.max(processedData, d => d.total_count)])
    .range([height, 0]);
  
  // Create area generator for stacked areas
  const pools = ['Lexicon', 'Idea', 'Practical', 'Experience'];
  
  // Prepare stacked data
  const stackedData = processedData.map(d => {
    let cumulative = 0;
    const item = { timestamp: d.timestamp, total_count: d.total_count };
    
    pools.forEach(pool => {
      const count = d.pools[pool] || 0;
      item[pool + '_start'] = cumulative;
      item[pool + '_end'] = cumulative + count;
      cumulative += count;
    });
    
    return item;
  });
  
  // Create area generators for each pool
  pools.forEach((pool, index) => {
    const area = d3.area()
      .x(d => xScale(d.timestamp))
      .y0(d => yScale(d[pool + '_start']))
      .y1(d => yScale(d[pool + '_end']))
      .curve(d3.curveMonotoneX);
    
    g.append('path')
      .datum(stackedData)
      .attr('class', `area-${pool.toLowerCase()}`)
      .attr('d', area)
      .attr('fill', poolColors[pool] || '#6B7280')
      .attr('fill-opacity', 0.7)
      .attr('stroke', poolColors[pool] || '#6B7280')
      .attr('stroke-width', 1)
      .on('mouseover', function(event, d) {
        showTimelineTooltip(event, pool);
        d3.select(this).attr('fill-opacity', 0.9);
      })
      .on('mouseout', function(event, d) {
        hideTimelineTooltip();
        d3.select(this).attr('fill-opacity', 0.7);
      });
  });
  
  // Add processing rate line
  const line = d3.line()
    .x(d => xScale(d.timestamp))
    .y(d => yScale(d.total_count))
    .curve(d3.curveMonotoneX);
  
  g.append('path')
    .datum(processedData)
    .attr('class', 'processing-line')
    .attr('d', line)
    .attr('fill', 'none')
    .attr('stroke', '#FFFFFF')
    .attr('stroke-width', 2)
    .attr('stroke-dasharray', '3,3')
    .attr('opacity', 0.8);
  
  // Add processing burst indicators (peaks)
  const peaks = processedData.filter(d => d.total_count > 200);
  
  g.selectAll('.peak-indicator')
    .data(peaks)
    .enter().append('circle')
    .attr('class', 'peak-indicator')
    .attr('cx', d => xScale(d.timestamp))
    .attr('cy', d => yScale(d.total_count))
    .attr('r', 4)
    .attr('fill', '#FFFFFF')
    .attr('stroke', '#FF6B6B')
    .attr('stroke-width', 2)
    .style('cursor', 'pointer')
    .on('mouseover', function(event, d) {
      showProcessingBurstTooltip(event, d);
      d3.select(this).attr('r', 6);
    })
    .on('mouseout', function(event, d) {
      hideTimelineTooltip();
      d3.select(this).attr('r', 4);
    });
  
  // Add axes
  const xAxis = d3.axisBottom(xScale)
    .tickFormat(d3.timeFormat('%m/%d %H:%M'))
    .ticks(Math.min(6, processedData.length));
  
  const yAxis = d3.axisLeft(yScale)
    .ticks(6)
    .tickFormat(d => d + ' entities');
  
  g.append('g')
    .attr('class', 'x-axis')
    .attr('transform', `translate(0,${height})`)
    .call(xAxis)
    .selectAll('text')
    .attr('fill', '#9CA3AF')
    .attr('font-size', '11px')
    .style('text-anchor', 'end')
    .attr('dx', '-.8em')
    .attr('dy', '.15em')
    .attr('transform', 'rotate(-45)');
  
  g.append('g')
    .attr('class', 'y-axis')
    .call(yAxis)
    .selectAll('text')
    .attr('fill', '#9CA3AF')
    .attr('font-size', '11px');
  
  // Style axes
  g.selectAll('.x-axis path, .y-axis path, .x-axis line, .y-axis line')
    .attr('stroke', '#4B5563')
    .attr('stroke-width', 1);
  
  // Add legend
  const legend = g.append('g')
    .attr('class', 'legend')
    .attr('transform', `translate(${width - 120}, 20)`);
  
  pools.forEach((pool, index) => {
    const legendItem = legend.append('g')
      .attr('transform', `translate(0, ${index * 20})`);
      
    legendItem.append('rect')
      .attr('width', 12)
      .attr('height', 12)
      .attr('fill', poolColors[pool])
      .attr('fill-opacity', 0.7);
      
    legendItem.append('text')
      .attr('x', 16)
      .attr('y', 9)
      .attr('font-size', '11px')
      .attr('fill', '#E5E7EB')
      .text(pool);
  });
  
  // Add title annotation
  g.append('text')
    .attr('x', width / 2)
    .attr('y', -5)
    .attr('text-anchor', 'middle')
    .attr('font-size', '12px')
    .attr('font-weight', 'bold')
    .attr('fill', '#9CA3AF')
    .text('Knowledge Architecture Assembly • 4,058 entities processed over 4 days');
}

