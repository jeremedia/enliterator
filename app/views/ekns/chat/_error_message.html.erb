<div id="message-<%= message.id %>" class="mb-4">
  <div class="flex items-start space-x-3">
    <div class="flex-shrink-0">
      <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center">
        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    
    <div class="flex-1">
      <div class="text-sm text-gray-500 mb-1">Assistant • Error</div>
      
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <% if show_details %>
          <!-- Development mode: Show full error details -->
          <div class="space-y-3">
            <div class="flex items-start">
              <svg class="h-5 w-5 text-red-400 mr-2 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
              </svg>
              <div class="flex-1">
                <h3 class="text-sm font-medium text-red-800">
                  <%= message.error_class || error.class.name %>
                </h3>
                <p class="mt-1 text-sm text-red-700">
                  <%= message.error_message || error.message %>
                </p>
              </div>
            </div>
            
            <% if message.error_backtrace.present? %>
              <details class="mt-3">
                <summary class="text-sm text-red-600 cursor-pointer hover:text-red-800 select-none">
                  Show stack trace
                </summary>
                <pre class="mt-2 text-xs bg-gray-900 text-gray-100 p-3 rounded overflow-x-auto font-mono"><%= message.error_backtrace.join("\n") %></pre>
              </details>
            <% end %>
            
            <div class="mt-4 flex items-center space-x-3">
              <button class="text-sm bg-red-100 hover:bg-red-200 text-red-800 px-3 py-1.5 rounded transition-colors"
                      data-controller="chat-retry"
                      data-chat-retry-conversation-id-value="<%= message.conversation_id %>"
                      data-chat-retry-message-id-value="<%= message.id %>"
                      data-action="click->chat-retry#retry">
                <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Retry
              </button>
              
              <span class="text-xs text-gray-500">
                Message ID: <%= message.id %>
              </span>
            </div>
          </div>
        <% else %>
          <!-- Production mode: Show user-friendly error -->
          <div class="flex items-start">
            <svg class="h-5 w-5 text-red-400 mr-2 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <div class="flex-1">
              <p class="text-sm text-red-700">
                I encountered an error processing your request. Please try again.
              </p>
              <button class="mt-3 text-sm bg-red-100 hover:bg-red-200 text-red-800 px-3 py-1 rounded transition-colors"
                      data-controller="chat-retry"
                      data-chat-retry-conversation-id-value="<%= message.conversation_id %>"
                      data-chat-retry-message-id-value="<%= message.id %>"
                      data-action="click->chat-retry#retry">
                Try Again
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>