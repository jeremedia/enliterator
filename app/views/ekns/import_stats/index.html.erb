<% content_for :title, "#{@ekn.name} - Detailed Import Stats" %>
<% content_for :description, "Per-document evidence of extraction, entities, and relationships for #{@ekn.name}." %>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-indigo-900 text-white">
  <!-- Header -->
  <div class="border-b border-white/10 bg-black/20 backdrop-blur-sm sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
            <%= @ekn.name %> — Detailed Import Stats
          </h1>
          <p class="text-gray-300 mt-1">Evidence of intelligent processing for each imported file.</p>
        </div>
        <div class="flex items-center gap-3">
          <%= link_to ekn_dashboard_path(ekn_slug: @ekn.slug), class: "px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg transition-colors text-white" do %>
            ← Back to Dashboard
          <% end %>
          <%= link_to ekn_path(ekn_slug: @ekn.slug), class: "px-4 py-2 bg-white/10 hover:bg-white/20 rounded-lg transition-colors text-white" do %>
            Overview
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-gradient-to-r from-indigo-600/30 to-purple-600/30 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8">
      <%= form_with url: imports_path(ekn_slug: @ekn.slug), method: :get, local: true, class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="w-full md:w-auto md:min-w-[260px]">
          <%= f.label :q, "Search", class: "block text-sm text-gray-300 mb-1" %>
          <%= f.text_field :q, value: params[:q], placeholder: "filename, source type", class: "w-full px-3 py-2 rounded bg-white/10 text-white border border-white/10 focus:outline-none" %>
        </div>
        <div class="w-full md:w-auto md:min-w-[200px]">
          <%= f.label :batch_id, "Batch", class: "block text-sm text-gray-300 mb-1" %>
          <%= f.select :batch_id, options_for_select(@ekn.ingest_batches.order(created_at: :desc).pluck(:name, :id), selected: params[:batch_id]), include_blank: "All", class: "w-full px-3 py-2 rounded bg-white/10 text-white border border-white/10" %>
        </div>
        <div class="flex items-center gap-2 px-3 py-2 bg-white/5 rounded">
          <%= f.check_box :publishable_only, { checked: @publishable_only, class: "h-4 w-4" }, '1', '0' %>
          <label class="text-sm text-gray-200">Publishable only</label>
        </div>
        <div class="flex items-center gap-2 px-3 py-2 bg-white/5 rounded">
          <%= f.check_box :include_rights, { checked: @include_rights, class: "h-4 w-4" }, '1', '0' %>
          <label class="text-sm text-gray-200">Include Rights entities</label>
        </div>
        <div class="ml-auto">
          <%= f.submit "Apply", class: "px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 rounded-lg transition-colors font-medium" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Items List -->
  <div class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8 space-y-4">
    <% if @items.empty? %>
      <div class="text-gray-300">No imported items found for this EKN.</div>
    <% end %>

    <% @items.each do |item| %>
      <% summary = @summaries[item.id] || { pool_counts: {}, relationship_count: 0 } %>
      <div class="bg-black/40 backdrop-blur-sm rounded-xl p-5 border border-white/10">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="font-semibold text-white truncate"><%= File.basename(item.file_path.to_s) %></div>
            <div class="text-xs text-gray-400 truncate">Path: <%= item.file_path %></div>
            <div class="text-xs text-gray-400">Type: <%= item.media_type %> • Size: <%= number_to_human_size(item.size_bytes || item.file_size) %> • Hash: <%= item.file_hash || item.source_hash %></div>
            <div class="mt-2 flex flex-wrap gap-2 text-xs">
              <span class="px-2 py-1 bg-white/10 rounded">Triage: <%= item.triage_status %></span>
              <span class="px-2 py-1 bg-white/10 rounded">Lexicon: <%= item.lexicon_status %></span>
              <span class="px-2 py-1 bg-white/10 rounded">Pool: <%= item.pool_status %></span>
              <span class="px-2 py-1 bg-white/10 rounded">Graph: <%= item.graph_status %></span>
              <span class="px-2 py-1 bg-white/10 rounded">Embeddings: <%= item.embedding_status %></span>
            </div>
          </div>
          <div class="text-right text-sm">
            <div class="text-gray-300">Graph entities by pool</div>
            <div class="mt-1 flex flex-wrap gap-2 justify-end">
              <% summary[:pool_counts].each do |pool, c| %>
                <span class="px-2 py-1 bg-white/10 rounded text-xs"><%= pool %>: <span class="text-blue-300 font-semibold"><%= c %></span></span>
              <% end %>
            </div>
            <div class="mt-1 text-gray-300">Entities: <span class="text-indigo-300 font-semibold"><%= summary[:entity_count] || summary[:pool_counts].values.sum %></span></div>
            <div class="mt-2 text-gray-300">Relationships: <span class="text-purple-300 font-semibold"><%= summary[:relationship_count] %></span></div>
          </div>
        </div>

        <details class="mt-4 group">
          <summary class="cursor-pointer select-none text-sm text-gray-200 group-open:text-white">Show details</summary>
          <div class="mt-4">
            <%= turbo_frame_tag "item-#{item.id}-details", src: details_import_path(ekn_slug: @ekn.slug, id: item.id, include_rights: @include_rights) do %>
              <div class="text-gray-400 text-sm">Loading details…</div>
            <% end %>
          </div>
        </details>
      </div>
    <% end %>
  </div>
</div>
