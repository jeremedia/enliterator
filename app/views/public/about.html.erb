<% content_for :title, "About Enliterator - First Knowledge Navigator" %>

<div class="max-w-6xl mx-auto px-4 py-8">
  <!-- Hero Section -->
  <div class="text-center mb-12">
    <div class="inline-flex items-center space-x-2 mb-4">
      <h1 class="text-4xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
        Enliterator Platform
      </h1>
      <span class="text-2xl">🏆</span>
    </div>
    
    <div class="bg-gradient-to-r from-green-50 to-blue-50 border-l-4 border-green-500 p-6 rounded-lg mb-8">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <svg class="h-8 w-8 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="ml-3">
          <h2 class="text-2xl font-semibold text-green-800">
            HISTORIC ACHIEVEMENT: First Knowledge Navigator Completed!
          </h2>
          <p class="text-lg text-green-700 mt-2">
            <strong>Arctic Navigator</strong> achieved 100% certification on <%= @achievement_date %> - 
            the first systematic realization of Apple's 1987 Knowledge Navigator vision.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- What We Built -->
  <div class="grid lg:grid-cols-2 gap-12 mb-16">
    <div>
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Revolutionary Breakthrough</h2>
      <div class="prose prose-lg text-gray-600">
        <p class="text-xl leading-relaxed mb-6">
          <strong>Not just chatbots or search interfaces</strong> - Enliterator creates complete 
          <span class="text-blue-600 font-semibold">Enliterated Knowledge Navigators (EKNs)</span> 
          that embody true domain expertise.
        </p>
        
        <p class="mb-4">Each Knowledge Navigator:</p>
        <ul class="space-y-2">
          <li>🧠 <strong>Embodies domain expertise</strong> through fine-tuned models</li>
          <li>📚 <strong>Grounds every response</strong> in structured knowledge graphs</li>
          <li>🎭 <strong>Maintains specialist personality</strong> with consistent communication</li>
          <li>📖 <strong>Cites sources</strong> with rights awareness and provenance</li>
          <li>⚡ <strong>Adapts responses</strong> to user expertise levels</li>
        </ul>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-8">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">Arctic Navigator Status</h3>
      
      <% if @arctic_navigator %>
        <div class="space-y-4">
          <div class="flex justify-between items-center p-3 bg-green-50 rounded-lg">
            <span class="font-medium">Assembly Status</span>
            <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-semibold">
              <%= @arctic_navigator.metadata&.dig("assembly_status") || "COMPLETE" %>
            </span>
          </div>
          
          <div class="flex justify-between items-center p-3 bg-blue-50 rounded-lg">
            <span class="font-medium">Knowledge Entities</span>
            <span class="text-blue-600 font-bold"><%= number_with_delimiter(@arctic_navigator.total_nodes) %></span>
          </div>
          
          <div class="flex justify-between items-center p-3 bg-purple-50 rounded-lg">
            <span class="font-medium">Relationships</span>
            <span class="text-purple-600 font-bold"><%= number_with_delimiter(@arctic_navigator.total_relationships) %></span>
          </div>
          
          <div class="flex justify-between items-center p-3 bg-yellow-50 rounded-lg">
            <span class="font-medium">Performance Grade</span>
            <span class="text-yellow-600 font-bold">
              <%= @arctic_navigator.metadata&.dig("assembly_results", "performance_metrics", "performance_grade") || "A" %>
            </span>
          </div>
          
          <div class="flex justify-between items-center p-3 bg-indigo-50 rounded-lg">
            <span class="font-medium">Certification Rate</span>
            <span class="text-indigo-600 font-bold">
              <%= @arctic_navigator.metadata&.dig("assembly_results", "certification_status", "certification_rate") || "100.0" %>%
            </span>
          </div>
        </div>
        
        <div class="mt-6 text-center">
          <%= link_to "Experience Arctic Navigator", chat_path(ekn_slug: @arctic_navigator.slug), 
              class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold rounded-lg hover:from-blue-700 hover:to-purple-700 transition-all duration-200 shadow-lg" %>
        </div>
      <% else %>
        <p class="text-gray-500 italic">Arctic Navigator data not available</p>
      <% end %>
    </div>
  </div>

  <!-- 13-Stage Pipeline -->
  <div class="mb-16">
    <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">13-Stage EKN Creation Pipeline</h2>
    
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Knowledge Infrastructure -->
      <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6 border border-green-200">
        <div class="text-center mb-4">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-green-500 text-white rounded-full mb-3">
            <span class="font-bold">0-8</span>
          </div>
          <h3 class="text-xl font-bold text-green-800">Knowledge Infrastructure</h3>
          <p class="text-green-600 text-sm">Raw Data → Structured Knowledge</p>
        </div>
        
        <ul class="space-y-2 text-sm text-green-700">
          <li>• Mission framing & initialization</li>
          <li>• Data intake & processing</li>
          <li>• Rights & provenance tracking</li>
          <li>• Canonical term extraction</li>
          <li>• Entity pool filling</li>
          <li>• Knowledge graph assembly</li>
          <li>• Relationship discovery</li>
          <li>• Vector embeddings</li>
          <li>• Quality validation</li>
        </ul>
      </div>

      <!-- Conversational Intelligence -->
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-200">
        <div class="text-center mb-4">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-blue-500 text-white rounded-full mb-3">
            <span class="font-bold">9-11</span>
          </div>
          <h3 class="text-xl font-bold text-blue-800">Conversational Intelligence</h3>
          <p class="text-blue-600 text-sm">Knowledge → AI Capabilities</p>
        </div>
        
        <ul class="space-y-2 text-sm text-blue-700">
          <li>• Fine-tuned domain models</li>
          <li>• Training question generation</li>
          <li>• Personality calibration</li>
          <li>• Communication optimization</li>
          <li>• Specialist trait validation</li>
        </ul>
      </div>

      <!-- Navigator Assembly -->
      <div class="bg-gradient-to-br from-purple-50 to-violet-50 rounded-xl p-6 border border-purple-200">
        <div class="text-center mb-4">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-purple-500 text-white rounded-full mb-3">
            <span class="font-bold">12</span>
          </div>
          <h3 class="text-xl font-bold text-purple-800">Navigator Assembly</h3>
          <p class="text-purple-600 text-sm">AI → Complete Knowledge Navigator</p>
        </div>
        
        <ul class="space-y-2 text-sm text-purple-700">
          <li>• Integration validation</li>
          <li>• Performance testing</li>
          <li>• Apple 1987 certification</li>
          <li>• Production readiness</li>
          <li>• Complete assembly</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Technical Architecture -->
  <div class="bg-gray-50 rounded-xl p-8 mb-16">
    <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Revolutionary Architecture</h2>
    
    <div class="grid md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-xl font-bold text-gray-900 mb-4">Core Innovations</h3>
        <ul class="space-y-3 text-gray-700">
          <li class="flex items-start">
            <span class="inline-block w-2 h-2 bg-blue-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
            <span><strong>QueryOrchestrator:</strong> Intelligent routing through fine-tuned models</span>
          </li>
          <li class="flex items-start">
            <span class="inline-block w-2 h-2 bg-blue-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
            <span><strong>Grounded Responses:</strong> Every answer backed by knowledge graph entities</span>
          </li>
          <li class="flex items-start">
            <span class="inline-block w-2 h-2 bg-blue-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
            <span><strong>Personality Calibration:</strong> Consistent specialist communication</span>
          </li>
          <li class="flex items-start">
            <span class="inline-block w-2 h-2 bg-blue-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
            <span><strong>Rights Awareness:</strong> Transparent citation and usage policies</span>
          </li>
        </ul>
      </div>
      
      <div>
        <h3 class="text-xl font-bold text-gray-900 mb-4">Technology Stack</h3>
        <ul class="space-y-3 text-gray-700">
          <li class="flex items-start">
            <span class="inline-block w-2 h-2 bg-green-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
            <span><strong>Rails 8:</strong> Modern web application framework</span>
          </li>
          <li class="flex items-start">
            <span class="inline-block w-2 h-2 bg-green-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
            <span><strong>Neo4j + GenAI:</strong> Knowledge graph with embeddings</span>
          </li>
          <li class="flex items-start">
            <span class="inline-block w-2 h-2 bg-green-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
            <span><strong>OpenAI GPT-4.1-mini:</strong> Fine-tuned domain models</span>
          </li>
          <li class="flex items-start">
            <span class="inline-block w-2 h-2 bg-green-500 rounded-full mt-2 mr-3 flex-shrink-0"></span>
            <span><strong>MCP Tools:</strong> Multi-tool query processing</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Historic Significance -->
  <div class="text-center mb-16">
    <h2 class="text-3xl font-bold text-gray-900 mb-6">Historic Significance</h2>
    
    <div class="max-w-4xl mx-auto">
      <div class="bg-gradient-to-r from-amber-50 to-orange-50 border-l-4 border-amber-500 p-8 rounded-lg">
        <h3 class="text-2xl font-bold text-amber-800 mb-4">
          First Time in Computing History
        </h3>
        
        <div class="grid md:grid-cols-2 gap-6 text-left">
          <ul class="space-y-3 text-amber-700">
            <li class="flex items-start">
              <span class="text-amber-500 mr-2">✓</span>
              <span>Apple's 1987 Knowledge Navigator vision systematically realized</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-500 mr-2">✓</span>
              <span>Conversational AI embodies true domain expertise</span>
            </li>
          </ul>
          
          <ul class="space-y-3 text-amber-700">
            <li class="flex items-start">
              <span class="text-amber-500 mr-2">✓</span>
              <span>Reproducible pipeline for creating AI specialists</span>
            </li>
            <li class="flex items-start">
              <span class="text-amber-500 mr-2">✓</span>
              <span>Knowledge graph enables grounded conversation</span>
            </li>
          </ul>
        </div>
        
        <div class="mt-6 text-center">
          <p class="text-xl text-amber-800 font-semibold">
            The Arctic Navigator represents a fundamental shift from AI as "helpful assistant" 
            to AI as "knowledgeable specialist"
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Call to Action -->
  <div class="text-center">
    <h2 class="text-3xl font-bold text-gray-900 mb-6">Experience the Future of AI</h2>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <% if @arctic_navigator %>
        <%= link_to "Chat with Arctic Navigator", chat_path(ekn_slug: @arctic_navigator.slug), 
            class: "inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-bold text-lg rounded-lg hover:from-blue-700 hover:to-purple-700 transition-all duration-200 shadow-lg transform hover:scale-105" %>
      <% end %>
      
      <%= link_to "Explore Documentation", "#", 
          class: "inline-flex items-center px-8 py-4 bg-gray-100 text-gray-700 font-semibold text-lg rounded-lg hover:bg-gray-200 transition-all duration-200 shadow-md" %>
    </div>
    
    <p class="mt-6 text-gray-600 text-lg max-w-2xl mx-auto">
      Built with Rails 8, Neo4j, OpenAI GPT-4.1-mini, and the vision that 
      conversational AI should embody expertise, not just access it.
    </p>
  </div>
</div>

<!-- Additional Styling -->
<style>
  .prose ul {
    list-style: none;
    padding-left: 0;
  }
  
  .prose li {
    position: relative;
    padding-left: 1.5rem;
  }
  
  .prose li::before {
    content: '•';
    color: currentColor;
    position: absolute;
    left: 0;
  }
</style>